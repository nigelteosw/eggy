TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Used by providers.deepseek.api_key_env in config.example.yaml.
DEEPSEEK_API_KEY=
# Add one variable per additional providers.<name>.api_key_env value.
# OPENROUTER_API_KEY=

# Eggy's home directory: config.yaml, .env, auth.json, memories/, skills/,
# cron/, logs/, and state all live here. Defaults to /data.
# EGGY_HOME=

# First-boot settings used only when <home>/config.yaml does not exist.
# Accounts: the people who may use this Eggy, as id:google_email[:telegram_user_id],
# comma-separated, plus the Web application OAuth client they sign in with and
# Eggy's own Google Workspace address. Leave EGGY_ACCOUNTS empty for the
# single-owner shape below instead.
EGGY_ACCOUNTS=
EGGY_GOOGLE_LOGIN_CLIENT_ID=
EGGY_GOOGLE_LOGIN_CLIENT_SECRET=
EGGY_GOOGLE_EXPECTED_EMAIL=
# Single-owner shape (only without EGGY_ACCOUNTS).
EGGY_TELEGRAM_OWNER_ID=
EGGY_PUBLIC_BASE_URL=
EGGY_REPOSITORY_URL=
EGGY_REPOSITORY_NAME=
EGGY_REPOSITORY_BASE_BRANCH=
EGGY_REPOSITORY_PROTECTED_BRANCHES=

# Required when at least one repository is configured.
GITHUB_TOKEN=
# Encrypts per-server MCP OAuth records and signs web UI session cookies.
EGGY_ENCRYPTION_KEY=
# Optional: add one variable for each MCP server using auth: bearer-env.
# MY_MCP_BEARER_TOKEN=

# Required when tavily.enabled is true. Web search and page extraction.
# TAVILY_API_KEY=

# Optional, single-owner shape only: enables the password login for the web
# panel. Both must be set together; EGGY_ENCRYPTION_KEY (above) is then
# required too. Must be unset when EGGY_ACCOUNTS is used.
EGGY_UI_USER_EMAIL=
EGGY_UI_PASSWORD=
