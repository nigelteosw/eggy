# Guided setup (default): with none of the headless variables below set,
# Eggy serves a one-time setup page on first boot and you configure the
# first account and the model provider there. Only these credentials need
# to exist in the environment beforehand; the setup form lets you name the
# variables above, and these are just suggested names.

# Encrypts sessions and the Google Workspace grant. Required.
# Generate with: openssl rand -base64 32
EGGY_ENCRYPTION_KEY=

# The model provider's API key. Named by whatever you enter as the
# provider's "API key variable" during setup; DEEPSEEK_API_KEY is only the
# suggested default.
DEEPSEEK_API_KEY=
# Add one variable per additional provider you configure later from Settings.
# OPENROUTER_API_KEY=

# The web login of the first account (web.password_account_id in
# config.yaml): the username typed on the login form and its password. Both
# are required; every other person sets a local password from the People
# card instead. Changing these is the only way to rotate that account's
# password, and needs a restart.
EGGY_UI_USER_EMAIL=
EGGY_UI_PASSWORD=

# Recommended: your deployment's public HTTPS origin. Auto-detected on
# Railway (RAILWAY_PUBLIC_DOMAIN) and defaults to http://localhost:<port>
# otherwise, but setting it explicitly avoids surprises behind a proxy.
EGGY_PUBLIC_BASE_URL=

# Optional: only needed once you enable Telegram from Settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional override. The Discord bot token is normally pasted into Settings ->
# Connections -> Discord and stored encrypted; set it here only if you manage
# every secret in the environment.
DISCORD_BOT_TOKEN=

# Optional: only needed once at least one repository is configured.
GITHUB_TOKEN=

# Optional: only needed once tavily.enabled is set. Web search and page
# extraction.
# TAVILY_API_KEY=

# Optional: add one variable for each MCP server using auth: bearer-env.
# MY_MCP_BEARER_TOKEN=

# Optional: Eggy's own Google Workspace grant's client secret, once
# configured from Settings after your first sign-in (see
# docs/src/content/docs/configure/google-workspace.md). Name of your choosing.
# GOOGLE_CLIENT_SECRET=

# Optional: Eggy's home directory: config.yaml, .env, eggy.db, accounts/,
# skills/, runs/, and logs/ all live here. Defaults to /data.
# EGGY_HOME=

# --- Headless setup (alternate path) ---
# Set any of these instead of using the setup page, and Eggy generates
# config.yaml from them on first boot without serving the setup UI. Not
# needed alongside the guided path above; leave this whole section unset.
#
# Accounts: the people who may use this Eggy, as id[:telegram_user_id],
# comma-separated, plus optionally Eggy's own Google Workspace address. With
# more than one entry, EGGY_OWNER_ID names which of them the EGGY_UI_*
# credentials above sign in. Leave EGGY_ACCOUNTS empty for the single-owner
# shape below instead.
# EGGY_ACCOUNTS=
# EGGY_OWNER_ID=
# EGGY_GOOGLE_EXPECTED_EMAIL=
# Single-owner shape (only without EGGY_ACCOUNTS).
# EGGY_TELEGRAM_OWNER_ID=
# EGGY_REPOSITORY_URL=
# EGGY_REPOSITORY_NAME=
# EGGY_REPOSITORY_BASE_BRANCH=
# EGGY_REPOSITORY_PROTECTED_BRANCHES=
