---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const visibleHeadings = Astro.props.headings.filter(
  (heading: Heading) => heading.depth === 2 || heading.depth === 3,
);
---

{visibleHeadings.length > 0 && (
  <aside class="page-outline" aria-label="On this page">
    <p>On this page</p>
    <ol>
      {visibleHeadings.map((heading: Heading) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a href={`#${heading.slug}`} data-outline-link={heading.slug}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </aside>
)}
