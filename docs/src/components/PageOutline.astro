---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const visibleHeadings = Astro.props.headings.filter(
  (heading: Heading) => heading.depth === 2 || heading.depth === 3,
);
---

{visibleHeadings.length > 0 && (
  <aside class="page-outline" aria-label="On this page">
    <p>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h8M4 12h12M4 17h7"></path></svg>
      On this page
    </p>
    <ol>
      {visibleHeadings.map((heading: Heading, index: number) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a
            href={`#${heading.slug}`}
            data-outline-link={heading.slug}
            class:list={{ active: index === 0 }}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </aside>
)}
